# Used by script/Deploy.s.sol and `forge verify`. Never commit a real .env.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=

PROJECT_NAME=tiny-lib
MAINTAINER=0x0000000000000000000000000000000000000001
SPLIT_DELAY=172800

# One block per recipient, numbered from 0. BPS must sum to 10000.
R0_ADDR=0x0000000000000000000000000000000000000001
R0_BPS=4000
R0_LABEL=Meera (maintainer)
R1_ADDR=0x0000000000000000000000000000000000000002
R1_BPS=2000
R1_LABEL=Asha (contributor)
R2_ADDR=0x0000000000000000000000000000000000000003
R2_BPS=1000
R2_LABEL=Ravi (contributor)
R3_ADDR=0x0000000000000000000000000000000000000004
R3_BPS=2000
R3_LABEL=viem (upstream)
R4_ADDR=0x0000000000000000000000000000000000000005
R4_BPS=1000
R4_LABEL=OpenZeppelin (upstream)
